USING OSL.CONSOLE

FUNCTION RAISER()
    RETURN NOSUCHNAME
END FUNCTION

CLASS BOX
    PUBLIC VALUE
    CONSTRUCTOR(v)
        VALUE = v
    END CONSTRUCTOR
    FUNCTION PUT(v)
        VALUE = v
    END FUNCTION
    FUNCTION GET()
        RETURN VALUE
    END FUNCTION
END CLASS

FUNCTION SHADOW()
    VALUE = "local"
    PRINT "fn sees: " + VALUE
END FUNCTION

FUNCTION MAIN()
    PRINT "-- 1. constructor writes the field (bare name) --"
    b = NEW BOX(5)
    PRINT "value=" + b.GET()

    PRINT "-- 2. method writes the field, then reads it --"
    b.PUT(9)
    PRINT "value=" + b.GET()

    PRINT "-- 3. a local with the same name still wins --"
    SHADOW()
    PRINT "field untouched: " + b.GET()

    PRINT "-- 4. arrays --"
    a = [10, 20, 30]
    PRINT "count=" + COUNT(a)
    PRINT "a[0]=" + a[0] + " a[2]=" + a[2]
    a[1] = 99
    PRINT "a[1]=" + a[1]
    m = [[1, 2], [3, 4]]
    PRINT "nested m[1][0]=" + m[1][0]

    PRINT "-- 5. CATCH across a call --"
    TRY
        RAISER()
        PRINT "never"
    CATCH e1
        PRINT "caught call: " + e1
    END

    PRINT "-- 6. CATCH inside a method --"
    TRY
        b.PUT(NOSUCHNAME)
    CATCH e2
        PRINT "caught method: " + e2
    END

    PRINT "-- 7. globals --"
    GLOBAL G = 42
    PRINT "G=" + G

    PRINT "DONE"
END FUNCTION
