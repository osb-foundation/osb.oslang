CLASS Animal
    CONSTRUCTOR(name)
    END CONSTRUCTOR

    FUNCTION Speak()
        PRINT "Animal speaks"
    END FUNCTION
END CLASS

CLASS Dog : Animal
    CONSTRUCTOR(name)
        BASE(name)
    END CONSTRUCTOR

    FUNCTION Speak()
        PRINT "Dog barks"
    END FUNCTION
END CLASS

FUNCTION MAIN()
    VAR d
    d = NEW Dog("Rex")
    d.Speak()
END FUNCTION