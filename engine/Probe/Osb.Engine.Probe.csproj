<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <AssemblyName>OsbEngineProbe</AssemblyName>
    <RootNamespace>Osb.Engine.Probe</RootNamespace>

    <!-- Official .NET NativeAOT runtime (Alternative D, M8.3.5) -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Link Engine.Core source files directly (not via project reference) -->
  <ItemGroup>
    <Compile Include="../Core/Collections/*.cs" />
    <Compile Include="../Core/Eval/*.cs" />
    <Compile Include="../Core/Heap/*.cs" />
    <Compile Include="../Core/Host/*.cs" />
    <Compile Include="../Core/Lang/*.cs" />
    <Compile Include="../Core/Math/*.cs" />
    <Compile Include="../Core/Providers/*.cs" />
    <Compile Include="../Core/Values/*.cs" />
  </ItemGroup>

  <!-- Probe entry point -->
  <ItemGroup>
    <Compile Include="ProbeMain.cs" />
    <Compile Include="NativeRuntimeSmokeTests.cs" />
    <Compile Include="GlobalUsings.cs" />
  </ItemGroup>

</Project>
